# Copy to .env and replace these placeholders. Never commit .env or production keys.
DB_PASSWORD=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
JWT_ISSUER=http://localhost:8081
JWT_AUDIENCE=ecomm-api
JWT_KEY_ID=identity-1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Match the owner of .local/keys/private.pem so the non-root container can read the secret.
APP_UID=1000
APP_GID=1000
PORT=8081
MYSQL_PORT=3306
